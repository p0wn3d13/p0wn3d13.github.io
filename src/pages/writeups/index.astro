---
import Layout from '../../layouts/Layout.astro';

const ctfs = Object.values(import.meta.glob('./*.md', { eager: true }));
---

<Layout title="CTF Writeups | Mario (p0wn3d)">
    <section class="section" style="margin-top: 2rem;">
        <div class="section-header">
            <i class="fas fa-folder-open text-slate-400"></i>
            <h3>Write-ups de CTFs</h3>
        </div>
        
        <p style="color: var(--text-muted); margin-bottom: 2rem;">
            Resoluciones de máquinas, laboratorios y retos de ciberseguridad.
        </p>

        <div class="writeup-group">
            <div class="section-header">
                <i class="fas fa-flag text-indigo"></i>
                <h3>Máquinas y laboratorios</h3>
            </div>

            <div class="cards-list">
                {ctfs.map((post: any) => (
                    <a href={post.url} class="card writeup-card">
                        <h4>{post.frontmatter.title}</h4>
                        <div class="writeup-footer">
                            <span>Leer resolución</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
</Layout>