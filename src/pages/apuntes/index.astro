---
import Layout from '../../layouts/Layout.astro';

const notes = Object.values(import.meta.glob('./*.md', { eager: true }));
---

<Layout title="Apuntes | Mario (p0wn3d)">
    <section class="section" style="margin-top: 2rem;">
        <div class="section-header">
            <i class="fas fa-book-open text-violet"></i>
            <h3>Apuntes técnicos</h3>
        </div>

        <p style="color: var(--text-muted); margin-bottom: 2rem;">
            Notas de estudio sobre sistemas, redes, desarrollo y ciberseguridad.
        </p>

        {notes.length ? (
            <div class="cards-list">
                {notes.map((post: any) => (
                    <a href={post.url} class="card writeup-card">
                        <h4>{post.frontmatter.title}</h4>
                        <div class="writeup-footer">
                            <span>Leer apunte</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>
                ))}
            </div>
        ) : (
            <p class="writeup-empty">Todavía no hay apuntes publicados.</p>
        )}
    </section>
</Layout>
