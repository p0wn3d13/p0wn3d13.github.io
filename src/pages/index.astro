	<section id="contacto" class="section contact-section">
		<div class="section-header">
			<i class="fas fa-envelope"></i>
			<h3>Contacto</h3>
		</div>

		<div class="contact-card">
			<div class="contact-header">
				<h4>Envíame un mensaje</h4>
				<p>Rellena el formulario y te responderé lo antes posible.</p>
			</div>

			<form
				id="contactForm"
				action="https://api.web3forms.com/submit"
				method="POST"
				class="contact-form"
			>
				<input
					type="hidden"
					name="access_key"
					value="873c04a0-d67e-4c30-876e-9de99344c33b"
				/>

				<!-- Protección contra bots (Honeypot) -->
				<input
					type="checkbox"
					name="botcheck"
					class="hidden"
					style="display: none;"
				/>

				<div class="form-row">
					<div class="form-group">
						<label for="name">Nombre</label>
						<input
							type="text"
							name="name"
							id="name"
							placeholder="Tu nombre"
							required
						/>
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input
							type="email"
							name="email"
							id="email"
							placeholder="tu@email.com"
							required
						/>
					</div>
				</div>

				<div class="form-group">
					<label for="subject">Asunto</label>
					<input
						type="text"
						name="subject"
						id="subject"
						placeholder="¿De qué quieres hablar?"
						required
					/>
				</div>

				<div class="form-group">
					<label for="message">Mensaje</label>
					<textarea
						name="message"
						id="message"
						rows="4"
						placeholder="Escribe tu mensaje aquí..."
						required></textarea>
				</div>

				<button type="submit" class="submit-btn">
					Enviar mensaje <i class="fas fa-paper-plane"></i>
				</button>
			</form>
			<div
				id="formStatus"
				class="form-status"
				role="status"
				aria-live="polite"
			>
			</div>
		</div>
	</section>

	<script>
		// Scroll suave personalizado hacia la sección de contacto
		function smoothScroll(
			element: HTMLElement,
			duration: number = 1000,
		): void {
			const start = window.scrollY;
			const target = element.getBoundingClientRect().top + window.scrollY;
			const distance = target - start;
			let startTime: number | null = null;

			function easeInOutCubic(t: number): number {
				return t < 0.5
					? 4 * t * t * t
					: 1 - Math.pow(-2 * t + 2, 3) / 2;
			}

			function animation(currentTime: number): void {
				if (startTime === null) startTime = currentTime;
				const elapsed = currentTime - startTime;
				const progress = Math.min(elapsed / duration, 1);
				const ease = easeInOutCubic(progress);
				window.scrollTo(0, start + distance * ease);

				if (progress < 1) {
					requestAnimationFrame(animation);
				}
			}

			requestAnimationFrame(animation);
		}

		const mailBtn = document.getElementById("mailBtn");
		if (mailBtn) {
			mailBtn.addEventListener("click", (e: Event) => {
				e.preventDefault();
				const contacto = document.getElementById("contacto");
				if (contacto) {
					smoothScroll(contacto, 800);
				}
			});
		}

		const contactForm = document.getElementById(
			"contactForm",
		) as HTMLFormElement | null;
		const formStatus = document.getElementById("formStatus");
		const submitButton = contactForm?.querySelector(
			".submit-btn",
		) as HTMLButtonElement | null;
		const originalSubmitLabel = submitButton?.innerHTML ?? "";

		if (contactForm && formStatus && submitButton) {
			contactForm.addEventListener("submit", async (event: Event) => {
				event.preventDefault();

				if (!contactForm.checkValidity()) {
					contactForm.reportValidity();
					return;
				}

				submitButton.disabled = true;
				submitButton.innerHTML = "Enviando...";
				formStatus.className = "form-status form-status--loading";
				formStatus.textContent = "Enviando tu mensaje...";

				try {
					const response = await fetch(contactForm.action, {
						method: contactForm.method,
						body: new FormData(contactForm),
					});

					if (!response.ok) {
						throw new Error("No se pudo enviar");
					}

					contactForm.reset();
					formStatus.className = "form-status form-status--success";
					formStatus.textContent =
						"¡Mensaje enviado! Gracias por contactar.";
				} catch (error) {
					formStatus.className = "form-status form-status--error";
					formStatus.textContent =
						"No se pudo enviar el mensaje. Inténtalo de nuevo.";
				} finally {
					submitButton.disabled = false;
					submitButton.innerHTML = originalSubmitLabel;
				}
			});
		}
	</script>
</Layout>
